# DB
DATABASE_URL=postgresql://user:pass@localhost:5432/content_ops

# SUPABASE (preferred for auth/storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=content-ops

# STORAGE (choose one)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# OPENAI (optional for AI generation/assist)
OPENAI_API_KEY=

# INSTAGRAM GRAPH API
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=

# TIKTOK
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# WORKERS
TZ=Europe/Zurich
PUBLISHER_POLL_SECONDS=60
MAX_PUBLISH_RETRIES=5

# WEB -> WORKER CONTROL PLANE
ENABLE_UI_WORKER_TRIGGER=true
ENABLE_WORKER_CONTROL_QUEUE=true
UI_WORKER_TRIGGER_MODE=queue
UI_WORKER_TRIGGER_SPAWN_FALLBACK=true

# ENV MODE
APP_ENV=development
NODE_ENV=development

# WORKER CONTROL LOOP
WORKER_PUBLISHER_LOOP_ENABLED=true
WORKER_CONTROL_POLL_MS=5000
WORKER_CONTROL_CLAIM_BATCH_SIZE=4
WORKER_CONTROL_CLAIM_STALE_SECONDS=600
WORKER_CONTROL_RETRY_DELAY_SECONDS=30
WORKER_CONTROL_JOB_KEEPALIVE_MS=30000
WORKER_CONTROL_JOB_KEEPALIVE_FAILURE_THRESHOLD=3

# SUPERVISOR SINGLETON + HEARTBEAT
WORKER_SUPERVISOR_LOCK_KEY=control:supervisor:singleton
WORKER_SUPERVISOR_LEASE_SECONDS=600
WORKER_HEARTBEAT_STALE_SECONDS=90
WORKER_HEARTBEAT_RETENTION_DAYS=7

# PUBLISH LOOP + RETRIES
PUBLISH_DRY_RUN=true
PUBLISH_LOOP_POLL_MS=15000
PUBLISH_CLAIM_BATCH_SIZE=5
PUBLISH_CLAIM_STALE_SECONDS=600
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_DELAY_SECONDS=300
PUBLISH_MEDIA_PROXY_BASE_URL=
PUBLISH_MEDIA_PROXY_SECRET=
PUBLISH_MEDIA_PROXY_TTL_SECONDS=21600

# RENDER LOOP
RENDER_BATCH_SIZE=1
RENDER_MAX_BATCHES=0
RENDER_POST_TIMEOUT_MS=180000
RENDER_SLIDE_READY_TIMEOUT_MS=20000
RENDER_NETWORK_IDLE_TIMEOUT_MS=3000
RENDER_SLIDE_SETTLE_DELAY_MS=80
